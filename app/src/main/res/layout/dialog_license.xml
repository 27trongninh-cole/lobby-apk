<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Dialog kích hoạt tính năng "TỰ TẢI NHẠC LÊN" — Device-based Manual
     License Activation: hiện Device ID cố định của máy, người dùng tự gửi
     cho admin ngoài app để xin duyệt, rồi bấm "Kiểm tra kích hoạt" để app tự
     đọc bảng device_licenses trên Supabase xem đã được duyệt chưa. Xem
     com.echohall.kgvn.license.DeviceLicense. ═══ -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Hud.Panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textStyle="bold"
            android:textColor="@color/hud_accent"
            android:textSize="10.5sp"
            android:layout_marginBottom="8dp"
            android:text="KÍCH HOẠT TỰ TẢI NHẠC LÊN" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp"
            android:text="Tính năng này cần được admin duyệt theo từng máy. Gửi Device ID bên dưới cho admin, đợi duyệt, rồi quay lại bấm &quot;Kiểm tra kích hoạt&quot;." />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hud.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:textColor="@color/hud_text_muted"
                    android:textSize="9sp"
                    android:text="DEVICE ID" />

                <TextView
                    android:id="@+id/tvLicenseDeviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="12.5sp"
                    android:text="…" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnLicenseCopyId"
            style="@style/Widget.Hud.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="9dp"
                android:gravity="center"
                android:text="SAO CHÉP DEVICE ID"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/hud_text_secondary"
                android:textStyle="bold"
                android:textSize="10.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvLicenseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/hud_text_muted"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp"
            android:text="Chưa kiểm tra." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnLicenseClose"
                style="@style/Widget.Hud.Button.Ghost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="9dp"
                    android:gravity="center"
                    android:text="ĐÓNG"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textColor="@color/hud_text_secondary"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnLicenseCheck"
                style="@style/Widget.Hud.Button.Ghost"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                app:strokeColor="@color/hud_accent"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="9dp"
                    android:gravity="center"
                    android:text="KIỂM TRA KÍCH HOẠT"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:textColor="@color/hud_accent"
                    android:textStyle="bold"
                    android:textSize="10.5sp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
