<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Log debug — trình bày dạng terminal HUD, khớp phong cách log
     triển khai ở màn cài đặt (✓/▸ theo dòng). ═══ -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="520dp"
    style="@style/Widget.Hud.Panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            style="@style/Text.Hud.LabelAccent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOG.DEBUG"
            android:textSize="10.5sp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hud.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="10dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="10.5sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/hud_text_secondary"
                    android:text="" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCloseLog"
            style="@style/Widget.Hud.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:gravity="center"
                android:text="ĐÓNG"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/hud_text_secondary"
                android:textStyle="bold"
                android:textSize="11sp" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
