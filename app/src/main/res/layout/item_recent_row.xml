<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Hud.Card"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_reload"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvRecentName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Tên tổ hợp"
            android:textColor="@color/hud_text_primary"
            android:textSize="10.5sp"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvRecentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="vừa xong"
            android:textColor="@color/hud_text_muted"
            android:textSize="8.5sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
