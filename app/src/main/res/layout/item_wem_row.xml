<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Hud.Card"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/rowWemContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="9dp">

        <ImageView
            android:id="@+id/btnWemPlay"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="5dp"
            android:src="@drawable/ic_play"
            app:tint="@color/hud_text_muted"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_text_primary"
                android:textSize="12.5sp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Tên bài nhạc" />

            <TextView
                android:id="@+id/tvWemDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/hud_text_muted"
                android:textSize="9.5sp"
                android:layout_marginTop="1dp"
                android:text="0:00" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWemSelectedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:textStyle="bold"
            android:textColor="@color/hud_accent"
            android:textSize="8sp"
            android:text="ĐANG DÙNG"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
