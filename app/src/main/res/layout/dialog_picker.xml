<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060b12"
    android:paddingTop="18dp">

    <TextView
        android:id="@+id/tvPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn"
        android:textColor="#a0c8ee"
        android:textStyle="bold"
        android:textSize="17sp"
        android:paddingHorizontal="18dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etPickerSearch"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="18dp"
        android:background="@drawable/search_bar_bg"
        android:hint="Tìm kiếm..."
        android:textColorHint="#386080"
        android:textColor="#d8eeff"
        android:textSize="13sp"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPickerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingBottom="18dp" />

    <TextView
        android:id="@+id/tvPickerEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Không có kết quả khớp."
        android:textColor="#386080"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnPickerClose"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="14dp"
        android:background="@drawable/web_ghost_pill"
        android:text="Đóng"
        android:textColor="#a0c8ee"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
