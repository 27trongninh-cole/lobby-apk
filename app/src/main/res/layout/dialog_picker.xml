<?xml version="1.0" encoding="utf-8"?>
<!-- ═══ Dialog "Kho vật phẩm" — dùng chung cho picker nhạc (list) và video
     (lưới 2 cột, layout manager set trong code). Có sẵn 1 hàng "TỰ TẢI
     LÊN" cố định trong layout (btnPickerUpload) — MainActivity tự bật/tắt
     enabled + đổi nhãn/badge tuỳ màn (video: bật thật; nhạc: khoá, chỉ
     hiện badge "SẮP RA MẮT", theo đúng ghi chú trong README về tính năng
     tự upload nhạc rồi convert .wem chưa làm). ═══ -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="520dp"
    style="@style/Widget.Hud.Panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvPickerTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                style="@style/Text.Hud.LabelAccent"
                android:text="KHO VẬT PHẨM"
                android:textSize="10.5sp" />

            <ImageView
                android:id="@+id/btnPickerCloseIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:padding="2dp"
                android:src="@drawable/ic_close"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- ═══ Ô "Tự tải lên" — luôn ở vị trí đầu tiên, dễ thấy nhất. ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnPickerUpload"
            style="@style/Widget.Hud.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeColor="@color/hud_accent"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/hud_accent_bg_muted"
                android:padding="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_upload"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPickerUploadTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04"
                        android:textStyle="bold"
                        android:textColor="@color/hud_accent"
                        android:textSize="11sp"
                        android:text="TỰ TẢI VIDEO LÊN" />

                    <TextView
                        android:id="@+id/tvPickerUploadSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hud_text_secondary"
                        android:textSize="10sp"
                        android:layout_marginTop="1dp"
                        android:text="Chọn file từ máy của bạn" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPickerUploadBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="7.5sp"
                    android:letterSpacing="0.04"
                    android:textColor="@color/hud_text_muted"
                    android:background="@drawable/bg_pill_soft"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone"
                    android:text="SẮP RA MẮT" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Hud.Card"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_search"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/etPickerSearch"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Tìm theo tên..."
                    android:textColorHint="@color/hud_text_muted"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Hud.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THƯ VIỆN CÓ SẴN"
            android:textSize="8sp"
            android:layout_marginBottom="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPickerList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvPickerEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Không có kết quả khớp."
            android:textColor="@color/hud_text_muted"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
