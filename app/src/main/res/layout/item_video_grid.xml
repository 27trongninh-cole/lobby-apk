<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:foreground="?attr/selectableItemBackground"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVideoThumb"
        style="@style/Widget.Hud.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Dùng AspectRatioFrameLayout thay ConstraintLayout+dimensionRatio
             (xem javadoc trong AspectRatioFrameLayout.java) — khắc phục lỗi
             thumbnail bị bẹp dí trong lưới GridLayoutManager. -->
        <com.echohall.kgvn.AspectRatioFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivVideoThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/hud_surface_1" />

            <ImageView
                android:id="@+id/ivVideoThumbFallback"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_movie"
                app:tint="@color/hud_text_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVideoSelectedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:textStyle="bold"
                android:textColor="@color/hud_accent"
                android:textSize="7sp"
                android:text="DÙNG"
                android:background="@color/hud_accent_bg_muted"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp"
                android:layout_margin="4dp"
                android:visibility="gone" />

        </com.echohall.kgvn.AspectRatioFrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvVideoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/hud_text_secondary"
        android:textSize="10.5sp"
        android:ellipsize="end"
        android:singleLine="true"
        android:gravity="center"
        android:paddingTop="4dp"
        android:text="Tên video" />

</LinearLayout>
