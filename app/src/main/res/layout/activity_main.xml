<?xml version="1.0" encoding="utf-8"?>
<!-- ═══════════════════════════════════════════════════════════════════
     Màn hình chính — redesign HUD (góc vát kim cương, nhãn hệ thống mono,
     nút "KÍCH HOẠT TRANG BỊ"). Toàn bộ nội dung nằm trong 1
     Widget.Hud.Panel (MaterialCardView góc vát lớn) — panel này CHÍNH LÀ
     nội dung của cửa sổ nổi (Theme.Echohall windowIsFloating), không cần
     thêm nền/viền nào khác bên ngoài.
     ═══════════════════════════════════════════════════════════════════ -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.Hud.Panel">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- ═══ HEADER: trạng thái Shizuku kiểu log hệ thống ═══ -->
        <LinearLayout
            android:id="@+id/shizukuPill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnTopRightAction">

            <View
                android:id="@+id/tvShizukuDotView"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:rotation="45"
                android:background="@drawable/dot_indicator"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                style="@style/Text.Hud.LabelAccent"
                android:text="SHIZUKU // ĐANG KIỂM TRA"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnTopRightAction"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:src="@drawable/ic_terminal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintTop_toTopOf="@id/shizukuPill"
            app:layout_constraintBottom_toBottomOf="@id/shizukuPill"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nút cấp quyền — neo dưới header, preview tự nhảy lên khi nút GONE. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRequestPermission"
            style="@style/Widget.Hud.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/shizukuPill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvRequestPermissionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="9dp"
                android:gravity="center"
                android:text="CẤP QUYỀN SHIZUKU"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/hud_on_accent"
                android:textStyle="bold"
                android:textSize="12sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ PREVIEW 16:9 ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewClipFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            style="@style/Widget.Hud.Card"
            android:layout_marginTop="10dp"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toBottomOf="@id/btnRequestPermission"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginTop="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.echohall.kgvn.CropVideoView
                    android:id="@+id/previewVideo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/previewOverlayImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/preview_overlay"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    style="@style/Text.Hud.Label"
                    android:text="PREVIEW.LOBBY"
                    android:textSize="9sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/overlayToggleChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#99050810"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UI"
                        android:fontFamily="monospace"
                        android:textColor="@color/hud_text_secondary"
                        android:textSize="8.5sp"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/tvOverlayToggleState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◆"
                        android:textColor="@color/hud_accent"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPreviewCaptionOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:background="#99050810"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/hud_text_primary"
                    android:textSize="10sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <LinearLayout
                    android:id="@+id/previewEmptyOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#cc0b1120"
                    android:gravity="center"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_play"
                        app:tint="@color/hud_text_muted"
                        android:layout_marginBottom="6dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ THANH PLAYBACK NHẠC ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutPlaybackBar"
            style="@style/Widget.Hud.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/previewClipFrame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:id="@+id/btnPlaybackToggle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="6dp"
                    app:tint="@color/hud_accent"
                    android:src="@drawable/ic_play"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <SeekBar
                    android:id="@+id/seekPlayback"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:progressTint="@color/hud_accent"
                    android:thumbTint="@color/hud_accent"
                    android:max="1000" />

                <TextView
                    android:id="@+id/tvPlaybackTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="0:00 / 0:00"
                    android:textColor="@color/hud_text_muted"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ 2 SLOT CHỌN NHẠC / VIDEO ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChooseWem"
            style="@style/Widget.Hud.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/layoutPlaybackBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cardChooseVideo"
            app:layout_constraintWidth_percent="0.475"
            app:layout_goneMarginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="9dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_disc"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SLOT A · NHẠC"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvSelectedWem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chưa chọn"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="11.5sp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChooseVideo"
            style="@style/Widget.Hud.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="@id/cardChooseWem"
            app:layout_constraintStart_toEndOf="@id/cardChooseWem"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="9dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_movie"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Hud.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SLOT B · VIDEO"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvSelectedVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chưa chọn"
                        android:textColor="@color/hud_text_primary"
                        android:textSize="11.5sp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══ CÀI GẦN ĐÂY ═══ -->
        <TextView
            android:id="@+id/tvRecentLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Text.Hud.Label"
            android:text="CÀI GẦN ĐÂY · BẤM ĐỂ CHỌN LẠI"
            android:textSize="8sp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardChooseWem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/layoutRecentList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/tvRecentLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══ PROGRESS ═══ -->
        <TextView
            android:id="@+id/tvProgressLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/hud_text_muted"
            android:textSize="9.5sp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/layoutRecentList"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:max="100"
            android:progressTint="@color/hud_accent"
            android:progressBackgroundTint="@color/hud_surface_1"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvProgressLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ═══ NÚT HÀNH ĐỘNG ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnInstall"
            style="@style/Widget.Hud.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.4"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="13dp"
                android:gravity="center"
                android:text="KÍCH HOẠT TRANG BỊ"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:textColor="@color/hud_on_accent"
                android:textStyle="bold"
                android:textSize="13sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnReinstallLast"
            style="@style/Widget.Hud.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnInstall"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnUninstallAll"
            app:layout_constraintWidth_percent="0.475">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:gravity="center"
                android:text="GẦN NHẤT"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/hud_text_secondary"
                android:textStyle="bold"
                android:textSize="10.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUninstallAll"
            style="@style/Widget.Hud.Button.Ghost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:clickable="true"
            android:focusable="true"
            app:strokeColor="@color/hud_border_danger"
            app:layout_goneMarginStart="0dp"
            app:layout_constraintTop_toTopOf="@id/btnReinstallLast"
            app:layout_constraintStart_toEndOf="@id/btnReinstallLast"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:gravity="center"
                android:text="GỠ MOD"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/hud_danger"
                android:textStyle="bold"
                android:textSize="10.5sp" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
