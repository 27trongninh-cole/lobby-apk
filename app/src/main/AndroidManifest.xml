<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shizuku hoạt động qua Binder, không cần khai quyền hệ thống đặc biệt
         ở đây — quyền thật được Shizuku cấp lúc runtime qua chính app Shizuku. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Dự phòng cho thiết bị Android cũ hơn / các thao tác đọc file zip qua
         SAF không cần các quyền này, nhưng khai để tương thích rộng, không hại gì. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Melo Ninstaller"
        android:theme="@style/Theme.Echohall">

        <activity
            android:name=".MainActivity"
            android:label="Melo Ninstaller"
            android:exported="true"
            android:resizeableActivity="false"
            android:theme="@style/Theme.Echohall">
            <!-- resizeableActivity=false + theme dialog nổi (windowIsFloating,
                 xem styles.xml) — giữ cửa sổ ở đúng tỉ lệ đã phác thảo, tránh bị
                 kéo giãn khi xoay ngang hoặc vào chế độ chia đôi màn hình. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bắt buộc phải có provider này để Shizuku tìm thấy app khi liệt kê
             danh sách app được quản lý / nhận sự kiện binder. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
